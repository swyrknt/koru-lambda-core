# .gitignore
# Generated by Cargo
# will have compiled files and executables
/target/
**/target/
**/*.rs.bk

# Claude Code agent definitions (local, not part of the project)
.claude/agents/

# Warroom (5-agent review team) — local operational config, tracked in nested git
.claude/warroom/

# Local Claude Code settings (permissions, additional directories)
.claude/settings.local.json

# Cargo.lock IS committed, deliberately. The old guidance this comment used to
# cite — ignore it for libraries — predates the current advice, and ignoring it
# meant CI resolved `sha2`, `dashmap` and the rest fresh on every run, so
# "the suite passed" named no particular set of dependencies. Committing it
# does not constrain consumers: a downstream crate resolves its own.
#
# Note what this does and does not protect. It makes a build reproducible. It
# does NOT protect published identity — that rests on SHA-256 being SHA-256,
# and a `sha2` patch that changed its output would be a bug in `sha2` rather
# than drift here. What would catch such a bug is
# `tests/conformance_fixture.rs::a_live_engine_reproduces_the_fixture`, which
# compares a live engine against pinned hex, so the guard is the fixture and
# this is reproducibility.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# OS-specific
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation
/doc/

# Environment files
.env
.env.local
.env.production

# Logs
*.log
logs/
# Pinned exp18 corpus pair log — checked-in test fixture, never
# regenerated by CI. Overrides the `*.log` rule above.
!experiments/runner/tests/corpora/exp18.log

# Coverage
coverage/
*.profraw

# Build artifacts
dist/
pkg/
crates/koru-lambda-wasm/pkg/
*.tar.gz
*.zip

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Temporary folders
tmp/
temp/

# System files
*.orig

# Runtime data for benchmarks
benches/data/

# dhat heap profile output (`cargo run --example dhat_1m`)
dhat-heap.json

# Large test data
tests/large_data/

# Local configuration overrides
config/local.toml