# .gitignore
# Generated by Cargo
# will have compiled files and executables
/target/
**/target/
**/*.rs.bk

# Claude Code agent definitions (local, not part of the project)
.claude/agents/

# Warroom (5-agent review team) — local operational config, tracked in nested git
.claude/warroom/

# Local Claude Code settings (permissions, additional directories)
.claude/settings.local.json

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# OS-specific
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation
/doc/

# Environment files
.env
.env.local
.env.production

# Logs
*.log
logs/
# Pinned exp18 corpus pair log — checked-in test fixture, never
# regenerated by CI. Overrides the `*.log` rule above.
!tests/corpora/exp18.log

# Coverage
coverage/
*.profraw

# Build artifacts
dist/
pkg/
*.tar.gz
*.zip

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Temporary folders
tmp/
temp/

# System files
*.orig

# Runtime data for benchmarks
benches/data/

# dhat heap profile output (`cargo run --example dhat_1m`)
dhat-heap.json

# Large test data
tests/large_data/

# Local configuration overrides
config/local.toml