# .gitignore
# Generated by Cargo
# will have compiled files and executables
/target/
**/target/
**/*.rs.bk

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# OS-specific
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation
/doc/

# Environment files
.env
.env.local
.env.production

# Logs
*.log
logs/
# Phase 1.5 evidence — keep these tracked
!experiments/findings/run_log/*.log

# Coverage
coverage/
*.profraw

# Build artifacts
dist/
pkg/
*.tar.gz
*.zip

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Temporary folders
tmp/
temp/

# System files
*.orig

# Runtime data for benchmarks
benches/data/

# Large test data
tests/large_data/

# Local configuration overrides
config/local.toml

# Local dev tooling
warroom/
.claude/